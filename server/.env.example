# ============================================================
# JanSewa Backend — Environment Variables
# This file lives at server/.env (the process is started from
# the `server/` directory, so this is the file dotenv loads).
# NEVER commit real secrets to version control.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/jansewa

# --- Authentication ---
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string

# --- Email (used for password reset) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=noreply@jansewa.np

# --- SMS / Twilio (optional, future use) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- AI Integration (optional, future use) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- File Upload / Cloudinary (optional, future use) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend URL (for CORS + password reset links) ---
CLIENT_URL=http://localhost:3000

# --- Contact page ---
SUPPORT_EMAIL=support@jansewa.gov.np
